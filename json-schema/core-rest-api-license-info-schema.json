{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/api-evangelist/wiktionary/refs/heads/main/json-schema/core-rest-api-license-info-schema.json",
  "title": "LicenseInfo",
  "description": "LicenseInfo schema from Wiktionary MediaWiki Core REST API",
  "type": "object",
  "properties": {
    "url": {
      "type": "string",
      "format": "uri",
      "example": "https://creativecommons.org/licenses/by-sa/4.0/"
    },
    "title": {
      "type": "string",
      "example": "Creative Commons Attribution-Share Alike 4.0 International"
    }
  }
}