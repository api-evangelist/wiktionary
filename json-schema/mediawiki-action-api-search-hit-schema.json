{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/api-evangelist/wiktionary/refs/heads/main/json-schema/mediawiki-action-api-search-hit-schema.json",
  "title": "SearchHit",
  "description": "SearchHit schema from Wiktionary MediaWiki Action API",
  "type": "object",
  "properties": {
    "ns": {
      "type": "integer",
      "example": 0
    },
    "title": {
      "type": "string",
      "example": "hello"
    },
    "pageid": {
      "type": "integer",
      "example": 12345
    },
    "size": {
      "type": "integer",
      "example": 4321
    },
    "wordcount": {
      "type": "integer",
      "example": 412
    },
    "snippet": {
      "type": "string",
      "description": "HTML snippet of the matching excerpt.",
      "example": "A standard <span class=\"searchmatch\">greeting</span>."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "example": "2025-03-15T14:30:00Z"
    }
  }
}