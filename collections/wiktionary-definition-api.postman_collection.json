          "id": "5d854702-f11f-4e89-adc7-9d6ef0ac8203",
          "name": "Wiktionary Get Definition",
          "request": {
            "name": "Wiktionary Get Definition",
            "description": {
              "content": "Return a multilingual structured definition for a term, broken down by source language code (en, fr, de, …) and then by part of speech. Wiktionary-specific endpoint built on top of Parsoid parsing.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "page",
                "definition",
                ":term"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "redirect",
                  "value": "true",
                  "description": "Whether to follow page redirects (defaults to true)."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "term",
                  "description": "(Required) The dictionary term (URL-encoded; case-sensitive on Wiktionary)."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
