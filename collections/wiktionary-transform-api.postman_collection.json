                      "type": "any",
                      "value": "<string>",
                      "key": "title",
                      "description": "(Required) URL-encoded page title."
                    },
                    {
                      "disabled": false,
                      "type": "any",
                      "value": "<string>",
                      "key": "revision",
                      "description": "(Required) Revision id to anchor the round-trip against."
                    }
                  ]
                },
                "header": [
                  {
                    "disabled": false,
                    "description": "(Required) ETag from the corresponding /page/html call.",
                    "key": "If-Match",
                    "value": "<string>"
                  },
                  {
                    "key": "Accept",
                    "value": "text/plain"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"html\": \"<section><h2>English</h2><p>A standard greeting.</p></section>\",\n  \"scrub_wikitext\": true\n}",
