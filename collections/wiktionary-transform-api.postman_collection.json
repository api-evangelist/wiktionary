        {
          "id": "0f6ad909-c7e8-48a6-aaa3-58c794226bb5",
          "name": "Wiktionary Transform HTML to Wikitext",
          "request": {
            "name": "Wiktionary Transform HTML to Wikitext",
            "description": {
              "content": "Convert supplied Parsoid HTML back to wikitext for a given page and revision. Requires an If-Match ETag header. Rate-limited to 25 req/s.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "transform",
                "html",
                "to",
                "wikitext",
                ":title",
                ":revision"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "title",
                  "description": "(Required) URL-encoded page title."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "revision",
                  "description": "(Required) Revision id to anchor the round-trip against."
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) ETag from the corresponding /page/html call.",
                "key": "If-Match",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "text/plain"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"html\": \"<string>\",\n  \"scrub_wikitext\": \"<boolean>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "f8430f86-3fa5-4b21-85ac-cf6dee60370a",
              "name": "Wikitext body.",
              "originalRequest": {
                "url": {
                  "path": [
                    "transform",
                    "html",
                    "to",
                    "wikitext",
                    ":title",
                    ":revision"
