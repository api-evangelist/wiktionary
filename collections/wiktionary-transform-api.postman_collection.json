      "item": [
        {
          "id": "0f115f23-6649-488d-be56-17de01346fc5",
          "name": "Wiktionary Transform Wikitext to HTML",
          "request": {
            "name": "Wiktionary Transform Wikitext to HTML",
            "description": {
              "content": "Convert supplied wikitext to Parsoid HTML in the context of a page title. Rate-limited to 25 req/s (5 req/s with stash=true).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "transform",
                "wikitext",
                "to",
                "html",
                ":title"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "title",
                  "description": "(Required) URL-encoded page title context."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "text/html"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"wikitext\": \"<string>\",\n  \"body_only\": \"<boolean>\",\n  \"stash\": \"<boolean>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "f0482d00-e673-45fc-bd7d-3985a6efd8a4",
              "name": "Parsoid HTML.",
              "originalRequest": {
