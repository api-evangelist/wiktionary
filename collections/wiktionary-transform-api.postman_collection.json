  "info": {
    "_postman_id": "f538881b-7ff7-489d-b632-883a2156b300",
    "name": "Wiktionary MediaWiki Core REST Definition Transform API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The newer MediaWiki Core REST API, exposed per wiki at /w/rest.php. It offers a smaller, streamlined surface than the Action API for fetching page content, history, search, files, and revisions. On Wiktionary it serves the same content as the Action API in a more developer-friendly JSON shape. All content is CC BY-SA 4.0.\n\nContact Support:\n Name: Wikimedia Foundation",
      "type": "text/plain"
    }
  }
