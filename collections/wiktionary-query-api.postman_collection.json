          "name": "Wiktionary Query Action",
          "request": {
            "name": "Wiktionary Query Action",
            "description": {
              "content": "Dispatch any read-only MediaWiki Action API call. The `action` query parameter selects the module (query, parse, opensearch, expandtemplates). Use the more specific operations below for typed access, or pass arbitrary `action`/`format` values here.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api.php"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "action",
                  "value": "query",
                  "description": "(Required) Which Action API module to dispatch."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json",
                  "description": "Response format."
                },
                {
                  "disabled": false,
                  "key": "titles",
                  "value": "<string>",
                  "description": "Pipe-separated list of page titles (max 50 per request)."
                },
                {
                  "disabled": false,
                  "key": "prop",
                  "value": "<string>",
                  "description": "Properties to fetch (e.g. wikitext, extracts, revisions, links)."
                },
                {
                  "disabled": false,
                  "key": "list",
                  "value": "<string>",
                  "description": "Lists to fetch (e.g. search, allpages, recentchanges)."
                },
                {
                  "disabled": false,
                  "key": "meta",
                  "value": "<string>",
                  "description": "Meta information (e.g. siteinfo, tokens, userinfo)."
