      "item": [
        {
          "id": "2fc2fff2-4787-46e7-ace9-1ec8ac8bc290",
          "name": "Wiktionary OpenSearch Suggest",
          "request": {
            "name": "Wiktionary OpenSearch Suggest",
            "description": {
              "content": "Return autocomplete suggestions following the OpenSearch suggestions protocol. Response is a 4-element array (query, titles, descriptions, urls).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api.php"
              ],
              "hash": "opensearch",
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "action",
                  "value": "opensearch",
                  "description": "(Required) Must be `opensearch`."
                },
                {
                  "disabled": false,
                  "key": "search",
                  "value": "<string>",
                  "description": "(Required) Prefix to autocomplete."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "10",
                  "description": "Maximum number of suggestions to return."
                },
                {
                  "disabled": false,
                  "key": "namespace",
                  "value": "0",
                  "description": "Pipe-separated namespace numbers to search within."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json",
                  "description": "Response format."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "c527041c-baee-4ffb-aaf3-9f6dbbe63a31",
              "name": "OpenSearch suggestions response.",
              "originalRequest": {
