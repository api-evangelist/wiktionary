          "name": "Wiktionary Get Page History",
          "request": {
            "name": "Wiktionary Get Page History",
            "description": {
              "content": "Return a paged list of revisions for a page.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "page",
                ":title",
                "history"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "older_than",
                  "value": "<integer>",
                  "description": "Return revisions older than this revision id."
                },
                {
                  "disabled": false,
                  "key": "newer_than",
                  "value": "<integer>",
                  "description": "Return revisions newer than this revision id."
                },
                {
                  "disabled": false,
                  "key": "filter",
                  "value": "<string>",
                  "description": "Filter revisions (reverted, anonymous, bot, minor)."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "title",
                  "description": "(Required) URL-encoded page title."
