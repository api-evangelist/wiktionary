                "description": "Must be `opensearch`."
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Prefix to autocomplete."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of suggestions to return."
              },
              {
                "name": "namespace",
                "value": "",
                "type": "query",
                "description": "Pipe-separated namespace numbers to search within."
              },
              {
                "name": "format",
                "value": "",
                "type": "query",
                "description": "Response format."
              }
            ]
          },
          "docs": "Return autocomplete suggestions following the OpenSearch suggestions protocol. Response is a 4-element array (query, titles, descriptions, urls)."
        }
      ]
    }
  ],
  "bundled": true
